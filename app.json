{
  "expo": {
    "name": "uni-commu",
    "slug": "uni-commu",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/images/branding/unicommu-logo-v1.png",
    "scheme": "unicommu",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "requireFullScreen": false,
      "icon": "./assets/images/branding/unicommu-logo-v1.png"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#7747B8",
        "foregroundImage": "./assets/images/branding/unicommu-logo-v1.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/branding/unicommu-logo-v1.png"
    },
    "plugins": [
      "expo-router",
      ["expo-image-picker", { "photosPermission": "อนุญาตให้ UniCommu เลือกรูปภาพสำหรับโพสต์", "cameraPermission": false, "microphonePermission": false }],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#7747B8",
          "image": "./assets/images/branding/unicommu-logo-v1.png",
          "imageWidth": 104
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
